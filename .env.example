# Turso (hosted libSQL/SQLite) connection — create a free database with:
#   turso db create navlo-db
#   turso db show navlo-db          (gives TURSO_DATABASE_URL)
#   turso db tokens create navlo-db (gives TURSO_AUTH_TOKEN)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-token-here
